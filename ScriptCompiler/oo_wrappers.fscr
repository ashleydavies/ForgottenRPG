import "ScriptCompiler/mem";

struct EntityWrap {
    Entity* handle;
}

struct ItemWrap {
    Item* handle;
}

func EntityWrap @entity_from_player() {
    EntityWrap @e = malloc(sizeof EntityWrap);
    e->handle = get_player();
    return e;
}

func int EntityWrap::id() {
    return entity_get_id(this->handle);
}

func int EntityWrap::name_hash() {
    return entity_get_name_hash(this->handle);
}

func int EntityWrap::max_health() {
    return entity_get_max_health(this->handle);
}

func float EntityWrap::health() {
    return entity_get_health(this->handle);
}

func bool EntityWrap::is_dead() {
    return entity_is_dead(this->handle);
}

func bool EntityWrap::has_primary() {
    return entity_has_primary_equipped(this->handle);
}

func ItemWrap @EntityWrap::primary_item() {
    ItemWrap @item = malloc(sizeof ItemWrap);
    item->handle = entity_get_primary_item(this->handle);
    return item;
}

func void EntityWrap::send_damage(int amount) {
    entity_send_damage(this->handle, amount);
}

func string ItemWrap::name() {
    return item_get_name(this->handle);
}

func int ItemWrap::name_hash() {
    return item_get_name_hash(this->handle);
}
