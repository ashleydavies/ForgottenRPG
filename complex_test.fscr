struct Vec2 {
    int x;
    int y;
}

func Vec2 make_vec(int x, int y) {
    Vec2 v;
    v.x = x;
    v.y = y;
    return v;
}

func int dot(Vec2 a, Vec2 b) {
    return a.x * b.x + a.y * b.y;
}

struct Person {
    string name;
    int age;
}

func void Person::init(string name, int age) {
    this->name = name;
    this->age = age;
}

func bool Person::is_adult() {
    return this->age >= 18;
}

func string greet(Person p) {
    if p.is_adult() {
        return 'Greetings';
    }
    return 'Yo';
}

Vec2 a = make_vec(2, 3);
Vec2 b = make_vec(4, 5);
print dot(a, b);

Person joe;
joe.init('Joe', 20);
print joe.is_adult();
print greet(joe);

int count = 0;
for int i = 0; i < 3; i = i + 1 {
    count = count + i;
}
print count;

