struct Vec2 {
    int x;
    int y;
}

struct Rect {
    Vec2 min;
    Vec2 max;
}

struct Stats {
    int hp;
    int mp;
    int atk;
}

struct Actor {
    string name;
    Vec2 pos;
    Stats stats;
    int alive;
}

struct Item {
    int id;
    string name;
    int price;
}

struct Bag {
    Item a;
    Item b;
    int count;
}

struct Node {
    int id;
    Vec2 pos;
    Stats stats;
}

struct Pair {
    Node left;
    Node right;
}

struct Holder {
    Node @ptr;
}

struct Bundle {
    Holder h1;
    Holder h2;
}

func Vec2 make_vec(int x, int y) {
    Vec2 v;
    v.x = x;
    v.y = y;
    return v;
}

func Vec2 add_vec(Vec2 a, Vec2 b) {
    Vec2 r;
    r.x = a.x + b.x;
    r.y = a.y + b.y;
    return r;
}

func Vec2 scale_vec(Vec2 a, int s) {
    Vec2 r;
    r.x = a.x * s;
    r.y = a.y * s;
    return r;
}

func Rect make_rect(Vec2 min, Vec2 max) {
    Rect r;
    r.min = min;
    r.max = max;
    return r;
}

func int rect_area(Rect r) {
    int w = r.max.x - r.min.x;
    int h = r.max.y - r.min.y;
    return w * h;
}

func bool is_inside(Rect r, Vec2 p) {
    if p.x < r.min.x {
        return 0;
    }
    if p.y < r.min.y {
        return 0;
    }
    if p.x > r.max.x {
        return 0;
    }
    if p.y > r.max.y {
        return 0;
    }
    return 1;
}

func Stats make_stats(int hp, int mp, int atk) {
    Stats s;
    s.hp = hp;
    s.mp = mp;
    s.atk = atk;
    return s;
}

func int stats_total(Stats s) {
    return s.hp + s.mp + s.atk;
}

func Actor make_actor(string name, Vec2 pos, Stats stats) {
    Actor a;
    a.name = name;
    a.pos = pos;
    a.stats = stats;
    a.alive = 1;
    return a;
}

func void Actor::move(Vec2 delta) {
    Vec2 next = add_vec(this->pos, delta);
    this->pos = next;
}

func void Actor::damage(int amount) {
    this->stats.hp = this->stats.hp - amount;
    if this->stats.hp <= 0 {
        this->alive = 0;
    }
}

func int Actor::power() {
    return stats_total(this->stats);
}

func int actor_score(Actor a) {
    return a.stats.hp + a.stats.mp + a.stats.atk + a.pos.x + a.pos.y;
}

func void swap(int @a, int @b) {
    int t = !a;
    !a = !b;
    !b = t;
}

func int next_id() {
    static int id = 100;
    id = id + 1;
    return id;
}

func Item make_item(string name, int price) {
    Item it;
    it.id = next_id();
    it.name = name;
    it.price = price;
    return it;
}

func void Bag::add(Item it) {
    if this->count == 0 {
        this->a = it;
    } else {
        this->b = it;
    }
    this->count = this->count + 1;
}

func int Bag::total_value() {
    int total = 0;
    if this->count > 0 {
        total = total + this->a.price;
    }
    if this->count > 1 {
        total = total + this->b.price;
    }
    return total;
}

func void move_node(Node @n, Vec2 delta) {
    n->pos = add_vec(n->pos, delta);
}

func void hurt_node(Node @n, int dmg) {
    n->stats.hp = n->stats.hp - dmg;
}

func int node_power(Node n) {
    return stats_total(n.stats) + n.id;
}

func void swap_nodes(Node @a, Node @b) {
    Node temp = !a;
    !a = !b;
    !b = temp;
}

